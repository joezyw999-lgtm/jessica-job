# 面经整理 - Vercel 部署所需环境变量
# 在 Vercel Dashboard → Settings → Environment Variables 中逐一添加

# ==================== LLM API（必填）====================
# Coze 平台 API Key（用于调用豆包模型）
COZE_WORKLOAD_IDENTITY_API_KEY=

# Coze API 基础 URL
COZE_INTEGRATION_BASE_URL=https://api.coze.com

# Coze 模型 API 基础 URL
COZE_INTEGRATION_MODEL_BASE_URL=https://model.coze.com

# ==================== Supabase 数据库（必填）====================
# Supabase 项目 URL
COZE_SUPABASE_URL=

# Supabase 匿名密钥
COZE_SUPABASE_ANON_KEY=

# Supabase 服务角色密钥（用于后端绕过 RLS）
COZE_SUPABASE_SERVICE_ROLE_KEY=

# ==================== 对象存储 S3（必填）====================
# S3 端点 URL
COZE_BUCKET_ENDPOINT_URL=

# S3 桶名称
COZE_BUCKET_NAME=

# ==================== 项目配置（选填）====================
# 项目域名（Vercel 部署后填入实际域名，如 https://your-app.vercel.app）
COZE_PROJECT_DOMAIN_DEFAULT=

# 工作目录（Vercel 上不需要，留空即可）
# COZE_WORKSPACE_PATH=
